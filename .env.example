# PostgreSQL (Railway u otro proveedor)
DATABASE_URL=postgresql://biblioscan:biblioscan@localhost:5432/biblioscan

# Auth JWT (mínimo 32 caracteres en producción)
JWT_SECRET=change-me-to-a-long-random-string

# SSL para Postgres en Railway (recomendado en producción)
DATABASE_SSL=true

# Modo demo sin base de datos (solo desarrollo)
# BIBLIOSCAN_DEV_MODE=true
# NEXT_PUBLIC_BIBLIOSCAN_DEV_MODE=true

# Opcional
NEXT_PUBLIC_APP_URL=http://localhost:3000
